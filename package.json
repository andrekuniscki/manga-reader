{
  "name": "manga-reader",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that turns any manga chapter page into a clean reader.",
  "scripts": {
    "build": "npm run typecheck && node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "typescript": "^5.5.4",
    "webextension-polyfill": "^0.12.0",
    "@types/webextension-polyfill": "^0.10.7"
  }
}
